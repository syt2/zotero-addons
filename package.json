{
  "name": "zotero-addons",
  "type": "module",
  "version": "11.0.1",
  "config": {
    "addonName": "Add-on Market for Zotero",
    "addonID": "zoteroAddons@ytshen.com",
    "addonRef": "zoteroaddons",
    "addonInstance": "ZoteroAddons",
    "prefsPrefix": "extensions.zotero.zoteroaddons"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syt2/zotero-addons.git"
  },
  "author": "ytshen",
  "bugs": {
    "url": "https://github.com/syt2/zotero-addons/issues"
  },
  "homepage": "https://github.com/syt2/zotero-addons#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:unit && zotero-plugin test",
    "test:unit": "node --test test/*.test.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "mitt": "^3.0.1",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.9",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
